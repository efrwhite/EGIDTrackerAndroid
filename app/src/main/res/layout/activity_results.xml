<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".ResultsActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Date range filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EGIDTracker.PageLabel"
                        android:text="@string/start_date_label"
                        android:textColor="@color/primaryBackground" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/startDateLayout"
                        style="@style/Widget.EGIDTracker.PageField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:endIconContentDescription="@string/choose_date"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/Widget.EGIDTracker.PageField.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/date_hint"
                            android:inputType="none"
                            android:paddingEnd="4dp"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EGIDTracker.PageLabel"
                        android:text="@string/end_date_label"
                        android:textColor="@color/primaryBackground" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/endDateLayout"
                        style="@style/Widget.EGIDTracker.PageField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:endIconContentDescription="@string/choose_date"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/Widget.EGIDTracker.PageField.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/date_hint"
                            android:inputType="none"
                            android:paddingEnd="4dp"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Shown only when the scores can't be loaded -->
            <LinearLayout
                android:id="@+id/errorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/error_banner_bg"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="14dp"
                android:paddingEnd="22dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="@string/couldnt_load_scores"
                    android:textColor="@color/primaryBackground"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/errorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/lato_regular"
                    android:textColor="@color/nearBlack"
                    android:textSize="14sp"
                    tools:text="@string/scores_permission_error" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/date"
                    android:textColor="@color/primaryBackground"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:text="@string/score"
                    android:textColor="@color/primaryBackground"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/dashed_box"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/scoreRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/scoresEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_width="match_parent"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="@string/no_scores" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/genButton"
        style="@style/Widget.EGIDTracker.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="24dp"
        android:text="@string/generate_report" />
</LinearLayout>
