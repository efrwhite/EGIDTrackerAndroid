<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".AddAllergiesActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:text="@string/allergen" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/allergenNameLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/allergiesNameField"
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/allergen_name_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/igESwitch"
                style="@style/Widget.EGIDTracker.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ige_allergen" />

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="10dp"
                android:text="@string/date_of_diagnosis" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/diagnosisDateLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconContentDescription="@string/choose_date"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_hint"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="16dp"
                android:text="@string/severity" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/severityLayout"
                style="@style/Widget.EGIDTracker.PageField.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/severityInput"
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_severity"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="16dp"
                android:text="@string/notes_label" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/allergyNotesField"
                    style="@style/Widget.EGIDTracker.PageField.Notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="1000" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/clearSwitch"
                style="@style/Widget.EGIDTracker.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/allergen_cleared" />

            <!-- Shown only when the allergen is cleared -->
            <LinearLayout
                android:id="@+id/clearedDateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_marginTop="10dp"
                    android:text="@string/end_date" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/clearedDateLayout"
                    style="@style/Widget.EGIDTracker.PageField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:endIconContentDescription="@string/choose_date"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.EGIDTracker.PageField.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/date_hint"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.EGIDTracker.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="24dp"
        android:text="@string/save_allergen" />
</LinearLayout>
