<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a caregiver (AddCaregiverActivity); same design as the child profile form -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".AddCaregiverActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="40dp"
            android:paddingTop="32dp"
            android:paddingEnd="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/caregiverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="@string/add_caregiver_title"
                android:textColor="@color/onPrimary"
                android:textSize="30sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Photo: same rounded salmon square as the child profile; tap to add or change -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/caregiverPhoto"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="24dp"
                android:background="@color/lightSalmon"
                android:contentDescription="@string/add_photo"
                android:padding="0.5dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/caregiverTitle"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EGIDTracker.HomeAvatar"
                app:strokeColor="@color/onPrimary"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/caregiverPhotoLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/lato_bold"
                android:padding="8dp"
                android:text="@string/add_photo"
                android:textColor="@color/lavender"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/caregiverPhoto" />

            <!-- Splits the First / Last Name row in half -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/nameGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <TextView
                android:id="@+id/firstNameLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginTop="12dp"
                android:text="@string/first_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/caregiverPhotoLink" />

            <TextView
                android:id="@+id/lastNameLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginStart="6.5dp"
                android:layout_marginTop="12dp"
                android:text="@string/last_name"
                app:layout_constraintStart_toStartOf="@+id/nameGuide"
                app:layout_constraintTop_toBottomOf="@+id/caregiverPhotoLink" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/firstNameLayout"
                style="@style/Widget.EGIDTracker.AuthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="6.5dp"
                app:layout_constraintEnd_toStartOf="@+id/nameGuide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firstNameLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiverFirstName"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50"
                    android:nextFocusDown="@+id/caregiverLastName"
                    android:nextFocusForward="@+id/caregiverLastName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lastNameLayout"
                style="@style/Widget.EGIDTracker.AuthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6.5dp"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/nameGuide"
                app:layout_constraintTop_toBottomOf="@+id/lastNameLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/caregiverLastName"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- The account's login username: shown, read-only, on the account holder's own profile -->
            <LinearLayout
                android:id="@+id/usernameGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firstNameLayout"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.EGIDTracker.AuthLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/username" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.EGIDTracker.AuthField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:alpha="0.75"
                    android:enabled="false"
                    app:helperText="@string/username_fixed"
                    app:helperTextTextColor="@color/lavender">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/caregiverUsername"
                        style="@style/Widget.EGIDTracker.AuthField.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Same salmon pill as the child profile's Save -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/filled_roundedbg_accent"
                android:backgroundTint="@null"
                android:fontFamily="@font/lato_bold"
                android:letterSpacing="0"
                android:stateListAnimator="@null"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/onPrimary"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/usernameGroup" />

            <!-- Edit only: "Remove caregiver", or "Delete account" on the account holder's profile -->
            <TextView
                android:id="@+id/deleteAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/lato_bold"
                android:padding="8dp"
                android:text="@string/remove_caregiver"
                android:textColor="@color/lightSalmon"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/saveButton"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.elizabethwhitebaker.egidtracker.BackButton
            android:id="@+id/backButton"
            style="@style/Widget.EGIDTracker.BackButton"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp" />
    </FrameLayout>
</ScrollView>
