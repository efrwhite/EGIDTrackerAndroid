<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".AllergiesActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:text="@string/current_allergens" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/dashed_box"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:id="@+id/currentRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/currentEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_marginTop="44dp"
                    android:text="@string/no_current_allergens" />

                <Button
                    android:id="@+id/addAllergenButton"
                    style="@style/Widget.EGIDTracker.SmallAccentButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/add_allergen_short" />
            </LinearLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="28dp"
                android:text="@string/cleared_allergens" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/dashed_box"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/pastRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pastEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_width="match_parent"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="@string/cleared_allergens_empty" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
