<?xml version="1.0" encoding="utf-8"?>
<!-- Chooses which part of the endoscopy results to chart (EndoscopyButtonsActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".EndoscopyButtonsActivity">

    <include layout="@layout/view_page_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            style="@style/Widget.EGIDTracker.PageLabel"
            android:text="@string/choose_section" />

        <LinearLayout
            android:id="@+id/sectionRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/dashed_box"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <!-- fillList needs an empty view; there are always sections -->
        <View
            android:id="@+id/sectionsEmpty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
