<?xml version="1.0" encoding="utf-8"?>
<!-- The account's children and caregivers (ProfilesActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".ProfilesActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:text="@string/children" />

            <TextView
                android:id="@+id/childrenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/lato_regular"
                android:text="@string/profiles_child_hint"
                android:textColor="@color/mutedPurple"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/dashed_box"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:id="@+id/childRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/childrenEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_marginTop="36dp"
                    android:text="@string/no_children" />

                <Button
                    android:id="@+id/addChildlink"
                    style="@style/Widget.EGIDTracker.SmallAccentButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/add_child_button" />
            </LinearLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="28dp"
                android:text="@string/caregivers" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/dashed_box"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:id="@+id/caregiverRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/caregiversEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_marginTop="36dp"
                    android:text="@string/no_caregivers" />

                <Button
                    android:id="@+id/addCaregiverlink"
                    style="@style/Widget.EGIDTracker.SmallAccentButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/add_caregiver_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
