<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".AddMedicationActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:text="@string/medication_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/medNameLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/medNameField"
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/medication_name_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="16dp"
                android:text="@string/start_date" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/startDateLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconContentDescription="@string/choose_date"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_hint"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="16dp"
                android:text="@string/dosage" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dosageLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/medAmountField"
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/dosage_hint"
                    android:inputType="text"
                    android:maxLength="60" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="16dp"
                android:text="@string/notes_label" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/medNotesField"
                    style="@style/Widget.EGIDTracker.PageField.Notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="1000" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/discontinueSwitch"
                style="@style/Widget.EGIDTracker.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/discontinue_medication" />

            <!-- Shown only when discontinuing -->
            <LinearLayout
                android:id="@+id/endDateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/end_date" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/endDateLayout"
                    style="@style/Widget.EGIDTracker.PageField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:endIconContentDescription="@string/choose_date"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.EGIDTracker.PageField.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/date_hint"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/medSaveButton"
        style="@style/Widget.EGIDTracker.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="24dp"
        android:text="@string/save_medication" />
</LinearLayout>
