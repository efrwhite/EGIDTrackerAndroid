<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".QoLActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:id="@+id/qolScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- What each answer means -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashed_box"
                android:fontFamily="@font/lato_bold"
                android:gravity="center"
                android:lineSpacingExtra="4sp"
                android:padding="10dp"
                android:text="@string/qol_key"
                android:textColor="@color/primaryBackground"
                android:textSize="15sp" />

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="18dp"
                android:text="@string/visitDate" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dateLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconContentDescription="@string/choose_date"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_hint"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sections and questions, added by QoLActivity -->
            <LinearLayout
                android:id="@+id/questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveButton"
        style="@style/Widget.EGIDTracker.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="20dp"
        android:text="@string/save_answers" />
</LinearLayout>
