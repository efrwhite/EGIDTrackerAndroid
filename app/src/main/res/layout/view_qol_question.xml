<?xml version="1.0" encoding="utf-8"?>
<!-- One questionnaire item: the question, then five 0-4 answer buttons (QoLActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/questionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato_regular"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/nearBlack"
        android:textSize="15sp"
        tools:text="I have chest pain, ache, or hurt" />

    <!-- Five separate answer squares; QoLActivity keeps only one checked -->
    <LinearLayout
        android:id="@+id/answerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/answer0" style="@style/Widget.EGIDTracker.ChoiceButton" android:text="0" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/answer1" style="@style/Widget.EGIDTracker.ChoiceButton" android:text="1" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/answer2" style="@style/Widget.EGIDTracker.ChoiceButton" android:text="2" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/answer3" style="@style/Widget.EGIDTracker.ChoiceButton" android:text="3" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/answer4" style="@style/Widget.EGIDTracker.ChoiceButton" android:text="4" />
    </LinearLayout>
</LinearLayout>
