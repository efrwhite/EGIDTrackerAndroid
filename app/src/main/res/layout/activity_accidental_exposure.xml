<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".AccidentalExposureActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Report form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_box"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_marginTop="6dp"
                    android:text="@string/report_exposure"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/date" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateLayout"
                    style="@style/Widget.EGIDTracker.PageField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:endIconContentDescription="@string/choose_date"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.EGIDTracker.PageField.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/date_hint"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/description_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/itemLayout"
                    style="@style/Widget.EGIDTracker.PageField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/exposedItemTextField"
                        style="@style/Widget.EGIDTracker.PageField.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/exposure_item_hint"
                        android:inputType="textCapSentences"
                        android:maxLength="100" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.EGIDTracker.PageLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/notes_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.EGIDTracker.PageField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/descriptionTextField"
                        style="@style/Widget.EGIDTracker.PageField.Notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="1000" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/addAEButton"
                    style="@style/Widget.EGIDTracker.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/add_exposure" />
            </LinearLayout>

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="18dp"
                android:text="@string/history" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/dashed_box"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/historyRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/historyEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_width="match_parent"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:text="@string/no_exposures" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
