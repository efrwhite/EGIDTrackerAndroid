<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in a dashed list box (see PageUi.kt fillList) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_bold"
            android:textColor="@color/deepPurple"
            android:textSize="16sp"
            tools:text="Rice" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/lato_regular"
            android:textColor="@color/mutedPurple"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Started 11/10/2026"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato_bold"
        android:paddingStart="12dp"
        android:textColor="@color/primaryBackground"
        android:textSize="15sp"
        tools:text="Edit" />
</LinearLayout>
