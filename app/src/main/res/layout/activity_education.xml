<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".EducationActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- One button per EGID/EoE question; each opens its answer screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="64dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/whatEoEButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/whatEoE">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_search" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/whatEoE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/causesEoEButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/causesEoE"
                android:layout_marginTop="35dp">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_folder" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/causesEoE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/affectedEoEButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/affectedEoE"
                android:layout_marginTop="35dp">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_people" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/affectedEoE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/symptomsEoEButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/symptomsEoE"
                android:layout_marginTop="35dp">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_flask" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/symptomsEoE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/diagnosedEoEButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/diagnosedEoE"
                android:layout_marginTop="35dp">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_notepad" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/diagnosedEoE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/treatedEoEButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/treatedEoE"
                android:layout_marginTop="35dp">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_dna" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/treatedEoE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreInfoButton"
                style="@style/Widget.EGIDTracker.QuestionButton"
                android:contentDescription="@string/moreInfo"
                android:layout_marginTop="35dp">

                <ImageView
                    style="@style/Widget.EGIDTracker.QuestionIcon"
                    android:src="@drawable/ic_q_bulb" />

                <TextView
                    style="@style/Widget.EGIDTracker.QuestionLabel"
                    android:text="@string/moreInfo" />
            </LinearLayout>

        </LinearLayout>

        <com.elizabethwhitebaker.egidtracker.BackButton
            style="@style/Widget.EGIDTracker.BackButton"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            app:tint="@color/primaryBackground" />
    </FrameLayout>
</ScrollView>
