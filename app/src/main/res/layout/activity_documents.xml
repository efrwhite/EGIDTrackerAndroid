<?xml version="1.0" encoding="utf-8"?>
<!-- The selected child's documents, stored on this device (DocumentsActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".DocumentsActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/documentsLabel"
                style="@style/Widget.EGIDTracker.PageLabel"
                tools:text="Ginger's documents" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/lato_regular"
                android:text="@string/documents_hint"
                android:textColor="@color/mutedPurple"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/dashed_box"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:id="@+id/documentRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/documentsEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_marginTop="36dp"
                    android:text="@string/no_documents" />

                <Button
                    android:id="@+id/addButton"
                    style="@style/Widget.EGIDTracker.SmallAccentButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/add_document" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
