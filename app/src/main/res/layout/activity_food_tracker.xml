<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:orientation="vertical"
    tools:context=".FoodTrackerActivity">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Widget.EGIDTracker.PageLabel"
                android:text="@string/showing" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dateLayout"
                style="@style/Widget.EGIDTracker.PageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconContentDescription="@string/choose_date"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.EGIDTracker.PageField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/foodListLabel"
                style="@style/Widget.EGIDTracker.PageLabel"
                android:layout_marginTop="32dp"
                android:text="@string/todays_food" />

            <!-- The day's foods, or an empty message; Add food is always at the bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/dashed_box"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:id="@+id/foodRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/foodEmpty"
                    style="@style/Widget.EGIDTracker.EmptyText"
                    android:layout_marginTop="44dp"
                    android:text="@string/no_foods_logged" />

                <Button
                    android:id="@+id/addButton"
                    style="@style/Widget.EGIDTracker.SmallAccentButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/add_food_short" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
