<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a child. Also the last step of sign-up (see AddChildActivity.EXTRA_FIRST_TIME_USER). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".AddChildActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="40dp"
            android:paddingTop="32dp"
            android:paddingEnd="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/childTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="@string/add_your_child"
                android:textColor="@color/onPrimary"
                android:textSize="30sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Shown only during sign-up -->
            <TextView
                android:id="@+id/childSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/lato_regular"
                android:gravity="center"
                android:text="@string/add_child_subtitle"
                android:textColor="@color/lavender"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/childTitle"
                tools:visibility="visible" />

            <!-- Photo: same rounded salmon square as the Home card; tap to add or change -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/childPhoto"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="24dp"
                android:background="@color/lightSalmon"
                android:contentDescription="@string/add_photo"
                android:padding="0.5dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/childSubtitle"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EGIDTracker.HomeAvatar"
                app:strokeColor="@color/onPrimary"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/childPhotoLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/lato_bold"
                android:padding="8dp"
                android:text="@string/add_photo"
                android:textColor="@color/lavender"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/childPhoto" />

            <!-- Splits the First / Last Name row in half -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/nameGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <TextView
                android:id="@+id/firstNameLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginTop="12dp"
                android:text="@string/first_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/childPhotoLink" />

            <TextView
                android:id="@+id/lastNameLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginStart="6.5dp"
                android:layout_marginTop="12dp"
                android:text="@string/last_name"
                app:layout_constraintStart_toStartOf="@+id/nameGuide"
                app:layout_constraintTop_toBottomOf="@+id/childPhotoLink" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/firstNameLayout"
                style="@style/Widget.EGIDTracker.AuthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="6.5dp"
                app:layout_constraintEnd_toStartOf="@+id/nameGuide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firstNameLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/childFirstName"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50"
                    android:nextFocusDown="@+id/childLastName"
                    android:nextFocusForward="@+id/childLastName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lastNameLayout"
                style="@style/Widget.EGIDTracker.AuthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6.5dp"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/nameGuide"
                app:layout_constraintTop_toBottomOf="@+id/lastNameLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/childLastName"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Birth date: picked from a calendar, never typed -->
            <TextView
                android:id="@+id/birthDateLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginTop="14dp"
                android:text="@string/birth_date"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firstNameLayout" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/birthDateLayout"
                style="@style/Widget.EGIDTracker.AuthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:endIconContentDescription="@string/choose_birth_date"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/birthDateLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/childBirthDate"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:hint="@string/birth_date_hint"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/genderLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginTop="14dp"
                android:text="@string/gender_optional"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/birthDateLayout" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/genderLayout"
                style="@style/Widget.EGIDTracker.AuthField.Dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/genderLabel">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/childGender"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_option"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/dietLabel"
                style="@style/Widget.EGIDTracker.AuthLabel"
                android:layout_marginTop="14dp"
                android:text="@string/diet"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/genderLayout" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dietLayout"
                style="@style/Widget.EGIDTracker.AuthField.Dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dietLabel">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/childDiet"
                    style="@style/Widget.EGIDTracker.AuthField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Same salmon pill as the Register and Login buttons -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/filled_roundedbg_accent"
                android:backgroundTint="@null"
                android:fontFamily="@font/lato_bold"
                android:letterSpacing="0"
                android:stateListAnimator="@null"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/onPrimary"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dietLayout" />

            <!-- Shown only during sign-up -->
            <TextView
                android:id="@+id/skipLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/lato_bold"
                android:padding="8dp"
                android:text="@string/skip_for_now"
                android:textColor="@color/lavender"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/saveButton"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.elizabethwhitebaker.egidtracker.BackButton
            android:id="@+id/backButton"
            style="@style/Widget.EGIDTracker.BackButton"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp" />
    </FrameLayout>
</ScrollView>
