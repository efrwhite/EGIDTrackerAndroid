<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".PlanActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false">

        <!-- Shifted left so it lines up with the back arrow on other screens -->
        <com.elizabethwhitebaker.egidtracker.BackButton
            style="@style/Widget.EGIDTracker.BackButton"
            android:layout_marginTop="4dp"
            android:translationX="-21dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primaryBackground" />

        <TextView
            android:id="@+id/checkPlan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginTop="100dp"
            android:fontFamily="@font/lato_regular"
            android:text="@string/check_plans_for"
            android:textColor="@color/onSurface"
            android:textSize="36sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Selected child's first name, so it's clear whose plans these are -->
        <TextView
            android:id="@+id/planName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/lato_bold"
            android:maxLines="1"
            android:textColor="@color/primaryBackground"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/checkPlan"
            app:layout_constraintTop_toBottomOf="@+id/checkPlan"
            tools:text="Ginger" />

        <!-- Splits the two-tile rows in half -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/tileGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <LinearLayout
            android:id="@+id/accidentalExposureButton"
            style="@style/Widget.EGIDTracker.HomeTile"
            android:layout_width="0dp"
            android:layout_height="149dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/plan_tile_deep"
            android:contentDescription="@string/accidentalExposure"
            app:layout_constraintEnd_toStartOf="@+id/tileGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/planName">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plan_exposure" />

            <TextView
                style="@style/Widget.EGIDTracker.HomeTileLabel"
                android:layout_marginTop="16dp"
                android:text="@string/accidentalExposure"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dietButton"
            style="@style/Widget.EGIDTracker.HomeTile"
            android:layout_width="0dp"
            android:layout_height="149dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/plan_tile_salmon"
            android:contentDescription="@string/diet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tileGuide"
            app:layout_constraintTop_toTopOf="@+id/accidentalExposureButton">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plan_diet" />

            <TextView
                style="@style/Widget.EGIDTracker.HomeTileLabel"
                android:layout_marginTop="16dp"
                android:text="@string/diet"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/documentsButton"
            style="@style/Widget.EGIDTracker.HomeTile"
            android:layout_width="0dp"
            android:layout_height="109dp"
            android:layout_marginStart="11dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="11dp"
            android:background="@drawable/home_tile_lavender"
            android:contentDescription="@string/documents"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/accidentalExposureButton">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plan_documents" />

            <TextView
                style="@style/Widget.EGIDTracker.HomeTileLabel"
                android:layout_marginStart="32dp"
                android:text="@string/documents"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/medicationsButton"
            style="@style/Widget.EGIDTracker.HomeTile"
            android:layout_width="0dp"
            android:layout_height="149dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/plan_tile_purple"
            android:contentDescription="@string/medications"
            app:layout_constraintEnd_toStartOf="@+id/tileGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/documentsButton">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plan_medication" />

            <TextView
                style="@style/Widget.EGIDTracker.HomeTileLabel"
                android:layout_marginTop="16dp"
                android:text="@string/medications"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/endoscopyButton"
            style="@style/Widget.EGIDTracker.HomeTile"
            android:layout_width="0dp"
            android:layout_height="149dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/plan_tile_salmon"
            android:contentDescription="@string/endoscopy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tileGuide"
            app:layout_constraintTop_toTopOf="@+id/medicationsButton">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plan_endoscopy" />

            <TextView
                style="@style/Widget.EGIDTracker.HomeTileLabel"
                android:layout_marginTop="16dp"
                android:text="@string/endoscopy"
                android:textAllCaps="true" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
