<?xml version="1.0" encoding="utf-8"?>
<!-- Plan tile: rounded @color/lightSalmon with a thin @color/primaryBackground outline, ripple on tap -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lightSalmon" />
            <stroke android:width="1dp" android:color="@color/primaryBackground" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</ripple>
