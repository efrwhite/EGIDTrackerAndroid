<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EGIDTracker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#8A60B0</item>
        <item name="colorPrimaryVariant">@color/design_default_color_primary_variant</item>
        <item name="colorOnPrimary">@color/design_default_color_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/design_default_color_secondary</item>
        <item name="colorSecondaryVariant">@color/design_default_color_secondary_variant</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Landing page: no ActionBar (has its own in-layout title), background drawn
         edge-to-edge with light icons for a dark background. -->
    <style name="Base.Theme.EGIDTracker.Landing" parent="Theme.EGIDTracker">
        <!-- Also the launch screen: shown while the app starts, before the layout draws. -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash-screen attributes for Android 12+ are added in values-v31. -->
    <style name="Theme.EGIDTracker.Landing" parent="Base.Theme.EGIDTracker.Landing" />

    <!-- Login and other auth screens: no ActionBar, bars match the purple background. -->
    <style name="Theme.EGIDTracker.Auth" parent="Theme.EGIDTracker">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/primaryBackground</item>
        <item name="android:statusBarColor">@color/primaryBackground</item>
        <item name="android:navigationBarColor">@color/primaryBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Field label above a white input on the purple auth screens -->
    <style name="Widget.EGIDTracker.AuthLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- White rounded input field on the purple auth screens -->
    <style name="Widget.EGIDTracker.AuthField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/onPrimary</item>
        <item name="boxStrokeColor">@color/auth_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/fieldHint</item>
    </style>

    <style name="Widget.EGIDTracker.AuthField.EditText" parent="">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="android:textColorHint">@color/fieldHint</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Outlined pill "Continue with ..." button -->
    <style name="Widget.EGIDTracker.SocialButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeColor">@color/onPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@null</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>
</resources>
