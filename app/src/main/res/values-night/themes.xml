<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EGIDTracker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryBackground</item>
        <item name="colorPrimaryVariant">@color/deepPurple</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/lightSalmon</item>
        <item name="colorSecondaryVariant">@color/darkSalmon</item>
        <item name="colorOnSecondary">@color/nearBlack</item>
        <!-- Each screen draws its own header with a back arrow, so no default ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primaryBackground</item>
    </style>
</resources>